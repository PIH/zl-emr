E2E_BASE_URL=http://localhost:7071/openmrs
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
# Quote values that contain spaces
E2E_DEFAULT_PROVIDER_NAME="Super User"

# Optional second server, the HIV one (hiv-ci): the HIV, PMTCT, EID and PrEP forms, dispensing.xml and comment.xml are only
# offered by the HIV profile (config haiti,haiti-hiv,haiti-hiv-ci).
# Run it with: E2E_TARGET=hiv-ci npx playwright test   (only the specs tagged @hiv-ci run; a plain run skips them).
# Every setting below falls back to the primary server's one above when left out, except the base URL.
# E2E_HIV_CI_BASE_URL=http://localhost:7075/openmrs
# E2E_HIV_CI_USER_ADMIN_USERNAME=admin
# E2E_HIV_CI_USER_ADMIN_PASSWORD=Admin123
# The provider the forms select; when it is not listed on a form the first provider is chosen.
# E2E_HIV_CI_DEFAULT_PROVIDER_NAME="Super User"
# Session location (login) and expected encounter location. Default: Klinik Ekstèn (zl-ci). On the hiv-ci stack Klinik Ekstèn has
# no tags, so use a location that is a Login Location and carries the HIV Consult and Dispensing tags: Mirebalais.
# Multiplies the test, expect and action timeouts (30 s / 15 s / 15 s): the local hiv-ci server is slow (visit-page fragments take 5-10 s).
# E2E_HIV_CI_TIMEOUT_FACTOR=2
# E2E_HIV_CI_SESSION_LOCATION_UUID=a084f714-a536-473b-94e6-ec317b152b43
