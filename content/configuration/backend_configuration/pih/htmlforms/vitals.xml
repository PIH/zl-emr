            </div>
            <br/>

            <div id="pain" class="toggle-div">
                <uimessage code="pihcore.pain"/>
            </div>
            <div class="collapsible-content two-columns-without-divs">

                <p class="in-line">
                    <label>
                        <uimessage code="mirebalais.vitals.pain.scale" />
                    </label>
                    <obs id="pain" conceptId="PIH:20668" style="radio"
                         answers="0,2,4,6,8,10" answerLabels="0,2,4,6,8,10" />
                </p>

                <p class="in-line">
                    <label>
                        <uimessage code="mirebalais.vitals.svs" />
                    </label>
                    <obs conceptId="PIH:20665" style="radio"
                         answerConceptIds="PIH:1107,PIH:1901,PIH:1900,PIH:1903,PIH:20666" answerSeparator="" />
                </p>

                <p class="in-line">
                    <label>
                        <uimessage code="mirebalais.vitals.nrs" />
                    </label>
                    <obs conceptId="PIH:20667" />
                </p>

                <p class="in-line">
                    <label>
                        <uimessage code="mirebalais.vitals.bps" />
                    </label>
                    <obs conceptId="PIH:20668" />
                </p>
            </div>
            <br/>

        <div id="anc" class="toggle-div">
            <uimessage code="pihcore.prenatal"/>
        </div>
        <div class="collapsible-content">
            <p>
                <label>
                    <uimessage code="mirebalais.vitals.fetal.heart.rate"/>
