    <section id="pain" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="pihcore.pain">

        <div class="section-container two-columns">

            <div>
                <p class="in-line">
                    <label>
                        <uimessage code="mirebalais.vitals.pain.scale"/>
                    </label>
                    <obs id="pain" conceptId="PIH:20668" style="radio"
