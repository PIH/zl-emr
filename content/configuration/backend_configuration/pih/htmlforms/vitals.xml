    <includeIf velocityTest="$patient.gender == 'F' &amp;&amp; $patient.age &gt; 10  ">
        <section id="prenatal" sectionTag="fieldset" headerTag="legend" headerStyle="title"
                 headerCode="pihcore.prenatal">

            <div class="section-container">
                <div>
                    <p>
                        <label>
                            <uimessage code="mirebalais.vitals.fetal.heart.rate"/>
                        </label>
                        <span class="small">
                            <obs conceptId="CIEL:1440" showUnits="bpm"/>
                        </span>
                    </p>
                </div>
            </div>
        </section>
    </includeIf>

    <section id="con-comment" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="pihcore.visitNote.consultInfo.label">

        <div class="section-container two-columns">
            <div>
                <label>
                    <uimessage code="mirebalais.vitals.complaint.title"/>
                </label>
                <obs conceptId="CIEL:160531" id="chief_complaint" style="textarea"/>
            </div>

            <div>
                <label>
