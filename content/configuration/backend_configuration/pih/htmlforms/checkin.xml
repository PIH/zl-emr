<htmlform id="check-in-form" formUuid="660f4e34-b4c2-4666-bd9e-f7c07bac8190" formName="Checkin"
          formEncounterType="55a0d3ea-a4d7-4e88-8f01-5aceb2d3c61b" formVersion="4.0">

    <!-- if archives room is enabled we prompt for pulling dossier first -->
    <includeIf velocityTest="$sessionContext.session.getAttribute('currentAppId') == 'mirebalais.liveCheckin'">
        <includeIf velocityTest="$config.isComponentEnabled('archives')">
            <!-- in Mirebalais we prompt for pulling dossier -->
            <redirectOnSave url="/paperrecord/requestPaperRecord.page?patientId={{patient.id}}&amp;returnProvider=pihcore&amp;returnPage=router/activeAppRouter"/>
        </includeIf>

        <includeIf velocityTest="!$config.isComponentEnabled('archives')">
            <!-- otherwise redirect directly back to the check-in app -->
            <redirectOnSave url="/coreapps/findpatient/findPatient.page?app=mirebalais.liveCheckin"/>
        </includeIf>
    </includeIf>

    <!-- START ENTER/EDIT VERSION OF THE FORM -->
    <ifMode mode="VIEW" include="false">
        <style>
            span.bside {
                display: inline-block;
            }
        </style>

        <script type="text/javascript">

            jq(function() {

                // hack to make the datepicker show when the form is opened
                getField('encounterDate.value').datepicker('show');

                //Calling the function to restrict only number in a input which takes the input id in parameter
               restrictInputOnlyNumber("receiptNumber")

            });

        </script>

        <section id="checkin" sectionTag="section" headerStyle="title" headerCode="mirebalais.retrospectiveCheckin.label">

            <fieldset field-separator=", ">
                <legend><uimessage code="pihcore.details"/></legend>
                <h3><uimessage code="pihcore.details"/></h3>
                <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
                    <label subform-parameter="encounter-provider-label">
                        <uimessage code="mirebalais.retrospectiveCheckin.provider.label"/>
                    </label>
                    <span subform-parameter="encounter-provider-widget">
                        <encounterProviderAndRole default="currentUser"
                                                  encounterRole="cbfe0b9d-9923-404c-941b-f048adc8cdc0"
                                                  required="true"/>
                    </span>
                    <label subform-parameter="encounter-location-label">
                        <uimessage code="mirebalais.retrospectiveCheckin.location.label"/>
                    </label>
                    <span subform-parameter="encounter-location-widget">
                        <encounterLocation default="SessionAttribute:emrContext.sessionLocationId"
                                           tags="Check-In Location"/>
                    </span>
                    <label subform-parameter="encounter-date-label">
                        <uimessage code="mirebalais.retrospectiveCheckin.checkinDate.label"/>
                    </label>
                </subform>
            </fieldset>

            <fieldset id="type-of-visit-question" >
                <legend>
                    <uimessage code="mirebalais.retrospectiveCheckin.visitType.label"/>
                </legend>
                <h3>
                    <uimessage code="mirebalais.retrospectiveCheckin.visitType.label"/>
                </h3>

                <div class="two-columns">
                    <div>
                        <div>
                            <repeat>
                                <template>
                                    <field>
                                        <div>
                                            <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                 answerConceptId="{acId}" answerCode="{aLabel}"/>
                                        </div>
                                    </field>
                                </template>
                                <render acId="PIH:7705" aLabel="pihcore.generalConsult"/>
                                <render acId="CIEL:165048" aLabel="pihcore.pedConsult"/>
                                <render acId="CIEL:165019" aLabel="pihcore.intMedConsult"/>
                                <render acId="PIH:6192" aLabel="pihcore.emergency" />
                                <render acId="PIH:7706" aLabel="pihcore.location.dental"/>
                                <render acId="CIEL:168363" aLabel="pih.ncdConsult"/>
                                <render acId="PIH:Oncology" aLabel="pih.task.oncologyConsultNote.label"/>
                                <render acId="PIH:9355" aLabel="pihcore.radiology"/>
                                <render acId="PIH:6190"  aLabel="pihcore.labVisit"/>
                            </repeat>
                        </div>

                        <div>
                            <field>
                                <b>
                                    <label for="surgery-consult-visit">
                                        <uimessage code="pihcore.surgeryConsult"/>
                                    </label>
                                </b>
                            </field>
                            <repeat>
                                <template>
                                    <field>
                                        <div>
                                            <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                 answerConceptId="{acId}" answerCode="pihcore.{aLabel}"/>
                                        </div>
                                    </field>
                                </template>
                                <render acId="PIH:General Surgical Consultation" aLabel="genSurgery"/>
                                <render acId="PIH:Orthopedic Surgical Consultation" aLabel="orthoSurgery"/>
                                <render acId="PIH:21719" aLabel="uroSurgery"/>
                                <render acId="PIH:21720" aLabel="eyeSurgery"/>
                            </repeat>
                        </div>

                        <includeIf velocityTest="($patient.getAge($encounter.getEncounterDatetime()) &gt; 10) &amp;&amp; $patient.gender == 'F'">
                            <div>
                                <field>
                                    <b>
                                        <label for="womensHealth-visit">
                                            <uimessage code="pihcore.womensHealth"/>
                                        </label>
                                    </b>
                                </field>
                                <repeat>
                                    <template>
                                        <field>
                                            <div>
                                                <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                     answerConceptId="{acId}" answerCode="pihcore.{aLabel}"/>
                                            </div>
                                        </field>
                                    </template>
                                    <render acId="PIH:ANTENATAL CLINIC" aLabel="antenatal"/>
                                    <render acId="CIEL:166625" aLabel="postnatalConsult"/>
                                    <render acId="PIH:FAMILY PLANNING SERVICES" aLabel="familyPlanning.title"/>
                                    <render acId="PIH:Labor and delivery visit" aLabel="anc.delivery.title"/>
                                    <render acId="CIEL:165013" aLabel="gyn"/>
                                    <render acId="CIEL:1171" aLabel="c-section"/>
                                    <render acId="PIH:21722" aLabel="gynIntervent"/>
                                </repeat>
                            </div>
                        </includeIf>

                    </div>

                    <div>
                        <div>
                            <field>
                                <b>
                                    <label for="surgery-visit">
                                        <uimessage code="pihcore.surgeryIntervent"/>
                                    </label>
                                </b>
                            </field>
                            <field>
                                <label>
                                    <uimessage code="pihcore.genSurgery"/>:
                                </label>
                            </field>
                            <field>
                                <div class="indented">
                                    <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                         answerConceptId="PIH:20330" answerCode="pihcore.minorSurgery"/>
                                </div>
                            </field>
                            <field>
                                <div class="indented">
                                    <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                         answerConceptId="PIH:21723" answerCode="pihcore.majorSurgery"/>
                                </div>
                            </field>
                            <repeat>
                                <template>
                                    <field>
                                        <div>
                                            <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                 answerConceptId="{acId}" answerCode="pihcore.{aLabel}"/>
                                        </div>
                                    </field>
                                </template>
                                <render acId="PIH:21724" aLabel="orthoSurgery"/>
                                <render acId="PIH:21725" aLabel="eyeSurgery"/>
                                <render acId="PIH:21726" aLabel="uroSurgery"/>
                                <render acId="PIH:SURGERY" aLabel="otherSurgery"/>
                            </repeat>
                        </div>

                        <div>
                            <field>
                                <b>
                                    <label for="hospital-visit">
                                        <uimessage code="pihcore.hospitalized"/>
                                    </label>
                                </b>

                            </field>
                            <repeat>
                                <template>
                                    <field>
                                        <div>
                                            <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                 answerConceptId="{acId}" answerCode="pihcore.inpatient{aLabel}"/>
                                        </div>
                                    </field>
                                </template>
                                <render acId="PIH:21727" aLabel="IntMed"/>
                                <render acId="PIH:21728" aLabel="Surgery"/>
                                <render acId="PIH:21729" aLabel="PreOp"/>
                                <render acId="PIH:21730" aLabel="PostOp"/>
                                <render acId="PIH:HOSPITAL PEDIATRICS" aLabel="Peds"/>
                                <render acId="PIH:MATERNITY WARD" aLabel="Maternity"/>
                            </repeat>
                        </div>

                        <div>
                            <field>
                                <b>
                                    <label for="cert-visit">
                                        <uimessage code="pihcore.otherNonMedServices"/>
                                    </label>
                                </b>
                            </field>
                            <repeat>
                                <template>
                                    <field>
                                        <div>
                                            <obs conceptId="PIH:Type of HUM visit" style="checkbox"
                                                 answerConceptId="{acId}" answerCode="pihcore.{aLabel}"/>
                                        </div>
                                    </field>
                                </template>

                                <render acId="PIH:8883"  aLabel="mentalhealth.Psychosocial"/>
                                <render acId="PIH:21167" aLabel="birthCert"/>
                                <render acId="PIH:21166" aLabel="injuryCert"/>
                                <render acId="PIH:7694"  aLabel="prenupCert"/>
                                <!-- render acId="PIH:7702"  aLabel="healthCert"/ -->
                            </repeat>
                        </div>
                    </div>
                </div>
            </fieldset>

            <obsgroup groupingConceptId="PIH:Payment construct">
                <fieldset id="payment-amount-question" class="required">
                    <legend>
                        <uimessage code="mirebalais.retrospectiveCheckin.paymentAmount.label"/>
                    </legend>
                    <h3>
                        <uimessage code="mirebalais.retrospectiveCheckin.paymentAmount.label"/>
                    </h3>
                    <p class="left" style="color:grey">
                        <obs conceptId="PIH:Payment amount" id="paymentAmount"
                             showUnits="pihcore.currencySpaced" unitsCssClass="append-to-value" />
                    </p>

                </fieldset>

             
                <fieldset id="receipt-number-question">
                    <legend>
                        <uimessage code="mirebalais.retrospectiveCheckin.receiptNumber.label"/>
                    </legend>
                    <h3>
                        <uimessage code="mirebalais.retrospectiveCheckin.receiptNumber.label"/>
                    </h3>

                    <p class="left">
                        <obs conceptId="PIH:Receipt number" id="receiptNumber" showUnits="false"
                             unitsCssClass="append-to-value"  />
                        <br/>
                        
                    </p>

                </fieldset>
            </obsgroup>


            <ifMode mode="ENTER" include="true">

                <!-- ask about printing a wristband if there is a wristband configured at this location -->
                <includeIf velocityTest="$printer.fn.isDefaultPrinterConfigured($sessionContext.sessionLocation, $printer.type.WRISTBAND)">

                    <fieldset id="print-wristband-question" class="required">
                        <legend>
                            <uimessage code="mirebalais.checkin.printWristband"/>
                        </legend>
                        <h3>
                            <uimessage code="mirebalais.checkin.printWristband"/>
                        </h3>
                        <span class="error field-error" style="display: none" id="print-wristband-error"></span>
                        <p class="left">
                            <select id="print-wristband" size="2">
                                <option value="true" selected="selected"><uimessage code="emr.yes"/></option>
                                <option value="false"><uimessage code="emr.no"/></option>
                            </select>
                        </p>
                    </fieldset>

                </includeIf>
            </ifMode>

            </section>

        <submit/>
    </ifMode>
    <!-- END ENTER/EDIT VERSION OF THE FORM -->

    <!-- START VIEW VERSION OF THE FORM (just display answers to obs, not section title or provider, date, location) -->
    <ifMode mode="VIEW">

        <section id="checkin" sectionTag="section" headerStyle="title" headerLabel="">

            <span id="most-recent-encounter-title" style="display:none"><!--The Most Recent Encounter app in Core Apps replaces this with the "most recent" label--></span>

            <fieldset id="type-of-visit-question">
                <legend>
                    <uimessage code="mirebalais.retrospectiveCheckin.visitType.label"/>
                </legend>
                <h3>
                    <uimessage code="mirebalais.retrospectiveCheckin.visitType.label"/>
                </h3>

                <!-- support displaying up to 12 type of visit obs -->
                <p class="multilines-display">
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                    <obs conceptId="PIH:Type of HUM visit" id="typeOfVisit" />
                </p>
            </fieldset>

            <obsgroup groupingConceptId="PIH:Payment construct">
                <fieldset id="payment-amount-question" class="required">
                    <legend>
                        <uimessage code="mirebalais.retrospectiveCheckin.paymentAmount.label"/>
                    </legend>
                    <h3>
                        <uimessage code="mirebalais.retrospectiveCheckin.paymentAmount.label"/>
                    </h3>

                    <p class="left" style="color:grey">
                        <obs conceptId="PIH:Payment amount" id="paymentAmount"
                             showUnits="pihcore.currencySpaced" unitsCssClass="append-to-value" />
                    </p>
                </fieldset>

                <fieldset id="receipt-number-question">
                    <legend>
                        <uimessage code="mirebalais.retrospectiveCheckin.receiptNumber.label"/>
                    </legend>
                    <h3>
                        <uimessage code="mirebalais.retrospectiveCheckin.receiptNumber.label"/>
                    </h3>

                    <p class="left">
                        <obs conceptId="PIH:Receipt number" id="receiptNumber" showUnits="false"
                             unitsCssClass="append-to-value" style="dropdown" />
                    </p>
                </fieldset>
            </obsgroup>

        </section>
    </ifMode>
    <!-- END VIEW VERSION OF THE FORM -->


</htmlform>
