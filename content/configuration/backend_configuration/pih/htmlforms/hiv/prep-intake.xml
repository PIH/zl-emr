<htmlform id="prep-intake" class="simple-form-ui"
          formUuid="b4561256-ca1d-4377-89d4-f133341749bb"
          htmlformUuid="1b102c5f-1a44-46f4-8350-8af8b7e95883"
          formName="Pre-Exposure Prophylaxis (PrEP) Intake"
          formEncounterType="2fb72359-f6fe-4b37-bb11-9b4cb5fd6ca7"
          formVersion="1.0">

    <style type="text/css">

        .simple-form-ui input {
            min-width: 80%
        }

        form fieldset {
            min-width: 90%
        }

        form input[type="checkbox"], form input[type="radio"], .form input[type="checkbox"], .form input[type="radio"] {
            float: none;
            display: inline-block;
        }

        form label, .form label {
            display: inline-block;
        }
    </style>

    <translations defaultLocale="en">
        <code name="mlminm2">
            <variant locale="en" value="mL / min / 1.73 m&lt;sup&gt;2&lt;/sup&gt;"/>
            <variant locale="fr" value="mL / min / 1.73 m&lt;sup&gt;2&lt;/sup&gt;"/>
        </code>
    </translations>


    <div class="print-form-datestamps" style="display:none">
        <p><uimessage code="pihcore.form.created_on"/>:
            <lookup complexExpression="$form.dateCreated"/>
        </p>
        <p><uimessage code="pihcore.form.last_updated_on"/>:
            <lookup complexExpression="$form.dateChanged"/>
        </p>
        <p><uimessage code="pihcore.form.printed_on"/>:
            <lookup complexExpression="$formGeneratedDatetime"/>
        </p>
    </div>

    <ifMode mode="VIEW" include="false">
        <h2>
            <label>
                <uimessage code="pihcore.prepInit.title"/>
            </label>
        </h2>
    </ifMode>

    <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
        <span subform-parameter="encounter-location-widget">
            <encounterLocation default="SessionAttribute:emrContext.sessionLocationId" tags="Consult Note Location"/>
        </span>
        <span subform-parameter="encounter-provider-widget">
            <encounterProviderAndRole default="currentUser"
                                      encounterRole="4f10ad1a-ec49-48df-98c7-1391c6ac7f05"
                                      required="true"/>
        </span>
    </subform>

    <script type="text/javascript">
        jq( function() {
            updateLastCheckboxRequired("#pop-cat","#pop-required-msg",'<uimessage code="pihcore.required"/>');
        });
    </script>

    <section id="overview" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.lab.overview">
        <div class="section-container">
            <p id="pop-cat">
                <label>
                    <uimessage code="pihcore.populationCat" />
                    <span id='pop-required-msg' class='error field-error'></span>
                </label>
                <br/>

                <repeat>
                    <template>
                        <obs conceptId="CIEL:160581" style="checkbox"
                             answerConceptId="{aId}"
                             answerXXX="{aLabel}" />
                        <br/>
                    </template>

                    <render aId="CIEL:160578" aLabel="HARSAH" />
                    <render aId="CIEL:166513" aLabel="PS" />
                    <render aId="CIEL:166415" aLabel="TG" />
                    <render aId="CIEL:105" aLabel="pihcore.ivDrugUser" />
                    <render aId="CIEL:6096" aLabel="discordant" />
                    <render aId="CIEL:5622" aLabel="other" />
                </repeat>
            </p>

            <p class="side-by-side">
                <label>
                    <uimessage code="pihcore.socioEconomic.levelEducation" />
                </label>
                <obs id="school" conceptId="CIEL:1712" style="radio"
                     answerConceptIds="CIEL:1107,CIEL:1713,CIEL:1714,CIEL:159785"
                     answerCodes="pihcore.none.label,zl.registration.patient.levelOfStudy.primary.label,zl.registration.patient.levelOfStudy.secondary.label,zl.registration.patient.levelOfStudy.uni.label"/>
            </p>
        </div>
    </section>

    <section id="first-steps" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.stepsBeforePrep">
        <div class="section-container">
            <table>
                <tr>
                    <td></td>
                    <td></td>
                    <th>Date</th>
                </tr>

                <obsgroup groupingConceptId="PIH:11522" showIfEmpty="false">
                    <tr>
                    <!-- HIV test -->

                        <td>
                            <uimessage code="pihcore.lab.hiv.title"/>
                        </td>

                        <td>
                            <obs conceptId="CIEL:163722"
                                 answerConceptIds="CIEL:703,CIEL:664,CIEL:1138"
                                 answerCodes="pihcore.positiveSign,pihcore.negativeSign,pihcore.indeterminate"
                                 answerSeparator="&amp;nbsp;"
                                 style="radio"/>
                        </td>
                        <td>
                            <obs conceptId="PIH:DATE OF LABORATORY TEST" />
                        </td>
                    </tr>
                </obsgroup>

                <obsgroup groupingConceptId="PIH:11523" showIfEmpty="false">
                    <tr>
                    <!-- RPR test -->
                        <td>
                            <label>
                                <uimessage code="pihcore.lab.syphilis" />
                            </label>
                        </td>
                        <td>
                            <obs conceptId="PIH:RPR"
                                 answerConceptIds="PIH:REACTIVE,PIH:NON-REACTIVE"
                                 answerCodes="pihcore.reactive,pihcore.nonreactive"
                                 answerSeparator="&amp;nbsp;"
                                 style="radio"/>
                        </td>
                        <td>
                            <obs conceptId="PIH:DATE OF LABORATORY TEST" />
                        </td>
                    </tr>
                </obsgroup>

                <tr>
                    <td>
                        <label>
                            <uimessage code="pihcore.prepCounsel" />
                        </label>
                    </td>
                    <td colspan="2">
                        <p class="side-by-side">
                            <obs conceptId="CIEL:165335" style="radio"
                                 answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="pihcore.yes,pihcore.no" />
                        </p>
                    </td>
                </tr>

                <tr>
                    <td>
                        <label>
                            <uimessage code="pihcore.interestInPrep" />
                        </label>
                    </td>
                    <td colspan="2">
                        <p class="side-by-side">
                            <obs conceptId="CIEL:166657" style="radio"
                                 answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="pihcore.yes,pihcore.no" />
                        </p>
                    </td>
                </tr>

                <tr><!-- Modify this -->
                    <td colspan="3">
                        <label>
                            <b><uimessage code="pihcore.lab.lab_exam_results" /></b>
                        </label>
                        <br/>

                        <div class="three-columns">
                            <div>
                                <obs conceptId="CIEL:161134" labelCode="pihcore.lab.clCr"
                                     showUnits="mlminm2"/>
                            </div>
                            <div>
                                <p class="side-by-side">
                                    <uimessage code="pihcore.lab.hepBsAg.short"/>
                                    <br/>
                                    <obs conceptId="CIEL:159430"
                                         answerConceptIds="CIEL:703,CIEL:664,PIH:14693"
                                         answerCodes="pihcore.positiveSign,pihcore.negativeSign,pihcore.unavailable"
                                         answerSeparator="&amp;nbsp;"
                                         style="radio"/>
                                </p>
                            </div>
                            <div>
                                <includeIf velocityTest="$patient.gender == 'F' ">
                                    <!-- Pregnancy -->
                                    <uimessage code="pihcore.pregnancy.status"/>
                                    <br/>
                                    <obs conceptId="CIEL:45"
                                         answerConceptIds="CIEL:703,CIEL:664"
                                         answerCodes="pihcore.positiveSign,pihcore.negativeSign"
                                         answerSeparator="&amp;nbsp;"
                                         style="radio"/>
                                </includeIf>
                            </div>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td colspan="3">
                        <label>
                            <b><uimessage code="pihcore.prepScreening" /></b>
                        </label>
                        <br/>

                        <div class="two-columns">
                            <div>
                                <label>
                                    <uimessage code="pihcore.dateLastSex" />
                                </label>
                                <obs conceptId="PIH:20885" />
                            </div>
                            <div>
                                <p class="side-by-side">
                                    <label>
                                        <uimessage code="pihcore.acuteHIVsigns" />
                                    </label>
                                    <obs conceptId="PIH:20888" style="radio"
                                         answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="pihcore.yes,pihcore.no" />
                                </p>
                            </div>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td>
                        <label>
                            <uimessage code="pihcore.startPrep" />
                        </label>
                    </td>
                    <td colspan="2">
                        <p class="side-by-side">
                            <obs conceptId="PIH:20886" style="radio"
                                 answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="pihcore.yes,pihcore.no" />
                        </p>
                    </td>
                </tr>

            </table>
        </div>
    </section>

    <section id="consent" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.consent">

        <div class="section-container">
            <p class="side-by-side">
                <label>
                    <uimessage code="pihcore.prepConsent" />
                </label>
                <obs conceptId="PIH:20887" style="radio"
                     answerConceptIds="CIEL:1065,CIEL:1066" />
            </p>
        </div>
    </section>

         <style type="text/css">
            .orderwidget-section-header {
                font-size: 16px;
            }
            .order-field {
                display: inline-block;
                padding: 0px;
            }
            .order-field.action {
                display: block;
            }
            .order-field.dateActivated {
                padding-right: 20px;
            }

            .order-field-label {
                display: inline-block;
                padding-right: 5px;
                vertical-align: middle;
            }

            .order-field-label:after {
                content: "";
                white-space: pre;
            }

            .order-field-widget {
                display: inline-block;
            }
        </style>

    <section id="init-prep" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.initPrep">

        <div class="section-container">
            <div class="two-columns">
                <div>
                    <p class="side-by-side">
                        <label>
                            <uimessage code="pihcore.prepStartDate" />
                        </label>
                        <obs conceptId="PIH:20897" />
                    </p>
                </div>
                <div></div>
            </div>

            <h3>
                <label>
                    <uimessage code="pihcore.prepDrugOrders" />
                </label>
            </h3>
            <drugOrder>
                <orderTemplate>
                    <orderProperty name="action"/>
                    <div style="padding:0px;">
                        <orderProperty name="drug" label="pihcore.drugOrders.drug">
                            <option value="78f96a76-dfbe-11e9-8a34-2a2ae2dbcce4" label="TDF/3TC 300/300mg"/>
                            <option value="ac6a5bab-7df4-4275-af88-acdad53ccc97" label="FTC/TDF 200/300mg" />
                        </orderProperty>
                    </div>
                    <div style="padding:0px;">
                        <orderProperty name="dose" label="pihcore.visitNote.plan.dose"/>
                        <orderProperty name="doseUnits" value="1513AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" label=" ">
                            <option value="CIEL:1513"/>    <!-- Tablet -->
                            <option value="CIEL:1608"/>    <!-- Capsule -->
                            <option value="CIEL:161553"/>  <!-- mg -->
                        </orderProperty>
                        <orderProperty name="frequency" value="37328251-6759-4270-8a2e-8cab2c0b315b" label=" x "/>
                        <orderProperty name="route" value="46aaaca8-1f21-410a-aac9-67bfcc1fd577" label=" ">
                            <option value="CIEL:160240"/> <!-- Oral -->
                            <option value="CIEL:160242" label="IV"/> <!-- IV -->
                        </orderProperty>
                        <orderProperty name="dosingInstructions" textArea="true" textAreaRows="3" textAreaColumns="50" label=" "/>
                    </div>
                    <div style="padding:0px;">
                        <orderProperty name="dateActivated" label="pihcore.starting"/>
                        <orderProperty name="duration" label="pihcore.visitNote.for"/>
                        <orderProperty name="durationUnits" value="3cd70b68-26fe-102b-80cb-0017a47871b2" label=" "/>
                    </div>
                    <div style="padding:0px;">
                        <orderProperty name="quantity" label="pihcore.quantity"/>
                        <orderProperty name="quantityUnits" value="1513AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" label=" "/>
                        <orderProperty name="numRefills" value="0" label="pihcore.refills"/>
                    </div>
                    <div style="display:none;">
                        <orderProperty name="urgency" value="ROUTINE"/>
                        <orderProperty name="previousOrder"/>
                        <orderProperty name="careSetting" value="OUTPATIENT"/>
                    </div>
                    <div style="display:none;" class="order-discontinueReason">
                        <orderProperty name="discontinueReason">
                            <option value="CIEL:843"/>
                            <option value="CIEL:102"/>
                            <option value="CIEL:127750"/>
                            <option value="CIEL:1754"/>
                            <option value="CIEL:162853"/>
                            <option value="CIEL:1434"/>
                            <option value="CIEL:987"/>
                            <option value="CIEL:1253"/>
                            <option value="CIEL:1067"/>
                            <option value="CIEL:5622"/>
                        </orderProperty>
                        <orderProperty name="discontinueReasonNonCoded"/>
                    </div>
                </orderTemplate>
            </drugOrder>
        </div>
    </section>

    <section id="prevention" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.preventionAndEd.label">
        <div class="section-container">
            <p class="list-inline-wide">
                <label>
                    <uimessage code="pihcore.hivRiskCounsel" />
                </label>
                <obs conceptId="PIH:20898" style="radio"
                     answerConceptIds="CIEL:1065,CIEL:1066"
                     answerCodes="pihcore.yes,pihcore.no"/>
            </p>

            <p class="list-inline-wide">
                <label>
                    <uimessage code="pihcore.fp.condomsProvided" />
                </label>
                <obs conceptId="CIEL:159777" style="radio"
                     answerConceptIds="CIEL:1065,CIEL:1066"
                     answerCodes="pihcore.yes,pihcore.no"/>
            </p>

            <p class="list-inline-wide">
                <label>
                    <uimessage code="pihcore.lubeProvided" />
                </label>
                <obs conceptId="PIH:21424" style="radio"
                     answerConceptIds="CIEL:1065,CIEL:1066"
                     answerCodes="pihcore.yes,pihcore.no"/>
            </p>

            <includeIf velocityTest="$patient.gender == 'M' ">
                <p class="list-inline-wide">
                    <label>
                        <uimessage code="pihcore.vmmc" />
                    </label>
                    <obs conceptId="CIEL:166677" style="radio"
                         answerConceptIds="CIEL:145096,CIEL:163841"
                         answerCodes="pihcore.yes,pihcore.no"/>
                </p>
            </includeIf>

            <p>
                <label>
                    <uimessage code="pihcore.otherPrevention" />
                </label>
                <obs conceptId="PIH:21428" />
            </p>
        </div>
    </section>

    <section id="referral" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.transferReferralIn">
        <div class="section-container">
            <div class="two-columns">
                <div>
                    <p class="list-inline-wide">
                        <label>
                            <uimessage code="pihcore.followedElsewherePrEP" />
                        </label>
                        <obs id="previous-prep"
                             conceptId="CIEL:170089" style="radio"
                             answerConceptIds="CIEL:1065,CIEL:1066"
                             answerCodes="pihcore.yes,pihcore.no">
                            <controls>
                                <when value="CIEL:1065" thenDisplay="#est-prog-start"/>
                            </controls>
                        </obs>
                    </p>

                    <p id="est-prog-start">
                        <label>
                            <uimessage code="pihcore.estimatedProgramStartDate" />
                        </label>
                        <obs conceptId="PIH:21422" />
                    </p>

                    <label>
                        <uimessage code="pihcore.referenceClinic" />
                    </label>
                    <obs conceptId="PIH:11483" />

                    <br/>
                    <label>
                        <uimessage code="pihcore.referenceDate" />
                    </label>
                    <obs conceptId="CIEL:163181" allowTime="false" />
                </div>

                <div>
                    <p class="narrow">
                        <label>
                            <lookup expression="fn.getConcept('PIH:RETURN VISIT DATE').name"/>
                        </label>
                        <obs conceptId="PIH:RETURN VISIT DATE" allowFutureDates="true" allowPastDates="false" id="apptDate"/>
                    </p>
                </div>
            </div>


        </div>
    </section>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>

</htmlform>
